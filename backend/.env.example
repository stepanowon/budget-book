# 서버 설정
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String (Supabase Transaction Pooler 권장)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# JWT (openssl rand -hex 64 으로 생성 권장)
JWT_ACCESS_SECRET=<랜덤_256비트_시크릿>
JWT_REFRESH_SECRET=<랜덤_256비트_시크릿>
# Access Token 유효기간 (초) — 기본 1시간
JWT_ACCESS_TTL_SECONDS=3600
# Refresh Token 유효기간 (초) — 기본 30일
JWT_REFRESH_TTL_SECONDS=2592000

# bcrypt cost factor (12 이상 권장)
BCRYPT_COST=12

# CORS — 허용할 프론트엔드 Origin
CORS_ORIGIN=http://localhost:5173
